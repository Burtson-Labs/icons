{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": false,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["scripts/**/*.mjs", "site/build.mjs", "test/types.check.tsx"]
}
